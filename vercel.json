{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=0, must-revalidate",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/favicon.ico",
      "dest": "/static/favicon.ico",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/",
      "dest": "/static/index.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/journal",
      "dest": "/static/journal.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/channel",
      "dest": "/static/channel.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/pro",
      "dest": "/static/pro.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/pricing",
      "dest": "/static/pricing.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/payment",
      "dest": "/static/payment.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/partnership",
      "dest": "/static/partnership.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/strategy",
      "dest": "/static/strategy.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/dashboard",
      "dest": "/static/dashboard.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/p/wiki",
      "dest": "/static/wiki.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/p/pan",
      "dest": "/static/pan.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/p/note",
      "dest": "/static/note.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/p/channel",
      "dest": "/static/product.html",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Lawygo-Design-Release": "20261108-workspace-first"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "ENVIRONMENT": "production",
    "LAWYGO_SECURE_COOKIES": "1",
    "LAWYGO_PUBLIC_URL": "https://lawygo.lexid.site",
    "LAWYGO_UPLOAD_PATH": "/tmp/lawygo_uploads",
    "LAWYGO_NEWSLETTER_BASE_URL": "https://lawygo.lexid.site",
    "GOOGLE_REDIRECT_URI": "https://lawygo.lexid.site/api/google/callback"
  },
  "crons": [
    {
      "path": "/api/cron/google-sync",
      "schedule": "0 */6 * * *"
    }
  ],
  "regions": [
    "sin1"
  ]
}
