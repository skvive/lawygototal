# Never commit secrets. Copy this file to a secured runtime environment.
LAWYGO_DB_PATH=./data/lawygo.db
# Neon pooled URL for Vercel (omit locally to use SQLite)
# DATABASE_URL=postgresql://...@...-pooler.../neondb?sslmode=require
LAWYGO_PUBLIC_URL=https://lawygo.lexid.site
LAWYGO_UPLOAD_PATH=./data/uploads
LAWYGO_SECURE_COOKIES=0  # 운영 HTTPS 환경에서는 1
# Google Cloud OAuth 2.0 Web application (enable Blogger API v3 and YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8018/api/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LAWYGO_TOKEN_ENCRYPTION_KEY=
# Enable only after native membership lookup route is deployed and tested.
LAWYGO_NATIVE_IDENTITY_URL=
LAWYGO_REQUIRE_NATIVE_MEMBERSHIP=false
LAWYGO_DEFAULT_TENANT=demo
# Gemini AI request requires explicit user opt-in; model must exist in your account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Vercel Cron: Authorization Bearer <secret> → GET /api/cron/google-sync (6h Blogger/YouTube)
LAWYGO_CRON_SECRET=
# Pair these with existing LAWYGO Next.js deployment in staging first.
LAWYGO_NATIVE_BRIDGE_URL=https://lawygo.com/api/integrations/cms
LAWYGO_NATIVE_BRIDGE_SECRET=

# LAWYGO v3 marketing & subscription integration
# Server-to-server HMAC signature key (at least 32 characters); NOT Stripe's webhook secret.
LAWYGO_BILLING_WEBHOOK_KEY=
# Newsletter is disabled by default. Use TLS SMTP 465 or STARTTLS 587.
LAWYGO_NEWSLETTER_SMTP_HOST=
LAWYGO_NEWSLETTER_SMTP_PORT=465
LAWYGO_NEWSLETTER_SMTP_USER=
LAWYGO_NEWSLETTER_SMTP_PASSWORD=
LAWYGO_NEWSLETTER_FROM=
LAWYGO_NEWSLETTER_BASE_URL=https://pan.lawygo.com
LAWYGO_NEWSLETTER_ALLOW_SEND=false
# Production rate limiting / WAF / CAPTCHA must be configured at the gateway.
